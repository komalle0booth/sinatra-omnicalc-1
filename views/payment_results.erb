<!-- /views/payment/results.erb -->

<h1>Payment Results</h1>

<dl>
  <dt>
    APR
  </dt>
  <dd>
    <%= @the_apr_integer.to_fs(:percentage, {:precision => 4}) %>
  </dd>

  <dt>
    Number of years
  </dt>
  <dd>
    <%= @number_of_years.to_i %>
  </dd>

  <dt>
    Principal
  </dt>
  <dd>
    <%= @the_principal.to_fs(:currency) %>
  </dd>

  <dt>
    Payment
  </dt>
  <dd>
    <%= @payment.to_fs(:currency) %>
  </dd>
</dl>

<div><a href="/payment/new">Caculate another payment</a>
